/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: #f8f9fa;
    color: #333;
}

/* Navbar */
header {
    background: #002147;
    padding: 15px 0;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo img {
    height: 50px;
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    font-size: 16px;
}

.btn {
    background: #28a745;
    color: white;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
}

/* Hero Section */
.hero {
    background: url('https://ibb.co/Z6PFbKJV') center/cover no-repeat;
    text-align: center;
    padding: 100px 0;
    color: white;
}

.hero h1 {
    font-size: 2.5em;
}

.hero p {
    font-size: 1.2em;
    margin: 20px 0;
}

/* Section Styling */
section {
    padding: 50px 0;
    text-align: center;
}

h2 {
    font-size: 2.5em;
    margin-bottom: 20px;
}

/* Programs */
.program-grid, .mentor-grid {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.program-card, .mentor-card {
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    width: 300px;
}

/* Events */
.event-card {
    background: white;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
}

/* Contact */
form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 600px;
    margin: auto;
}

input, textarea {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

/* Footer */
footer {
    background: #002147;
    color: white;
    padding: 20px 0;
    text-align: center;
}
/* General Styling */
body {
    font-family: Arial, sans-serif;
    background-color: #ffe6a7;
    color: #432818;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Section Titles */
.section-title {
    text-align: center;
    font-size: 2rem;
    color: #6f1d1b;
    margin-bottom: 1.5rem;
}

/* Video Section */
.video-section {
    padding: 3rem 1rem;
    background-color: #bb9457;
    text-align: center;
}

.video-container {
    max-width: 800px;
    margin: 0 auto;
}

iframe {
    width: 100%;
    height: 450px;
    border-radius: 10px;
}

/* Client Section */
.client-section {
    padding: 3rem 1rem;
    background-color: #99582a;
    text-align: center;
}

.client-logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    justify-items: center;
}

.client-logos img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    transition: transform 0.3s ease-in-out;
}

.client-logos a:hover img {
    transform: scale(1.1);
}

