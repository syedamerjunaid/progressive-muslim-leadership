/* Color Palette */
:root {
    --deep-maroon: #6f1d1b;
    --golden-brown: #bb9457;
    --dark-brown: #432818;
    --earthy-brown: #99582a;
    --soft-cream: #ffe6a7;
}

/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: var(--soft-cream);
    color: var(--dark-brown);
}

/* Navbar */
header {
    background: var(--deep-maroon);
    padding: 15px 0;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo img {
    height: 50px;
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    color: var(--soft-cream);
    text-decoration: none;
    font-size: 16px;
}

.btn {
    background: var(--golden-brown);
    color: var(--dark-brown);
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

/* Hero Section */
.hero {
    background: url('https://ibb.co/Z6PFbKJV') center/cover no-repeat;
    text-align: center;
    padding: 100px 0;
    color: var(--soft-cream);
}

.hero h1 {
    font-size: 2.5em;
}

.hero p {
    font-size: 1.2em;
    margin: 20px 0;
}

/* Section Styling */
section {
    padding: 50px 0;
    text-align: center;
}

h2 {
    color: var(--deep-maroon);
    font-size: 2.5em;
    margin-bottom: 20px;
}

/* Cards */
.program-card, .mentor-card, .event-card {
    background: var(--golden-brown);
    color: var(--dark-brown);
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
}

/* Contact Form */
form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 600px;
    margin: auto;
}

input, textarea {
    padding: 10px;
    border: 1px solid var(--earthy-brown);
    border-radius: 5px;
}

/* Footer */
footer {
    background: var(--deep-maroon);
    color: var(--soft-cream);
    padding: 20px 0;
    text-align: center;
}

