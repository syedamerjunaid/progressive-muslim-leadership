/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: #f8f9fa;
    color: #333;
}

/* Navbar */
header {
    background: #002147;
    padding: 15px 0;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo img {
    height: 50px;
}

nav ul {
    list-style: none;
    display: flex;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    font-size: 16px;
}

.btn {
    background: #28a745;
    color: white;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
}

/* Hero Section */
.hero {
    background: url('https://ibb.co/Z6PFbKJV') center/cover no-repeat;
    text-align: center;
    padding: 100px 0;
    color: white;
}

.hero h1 {
    font-size: 2.5em;
}

.hero p {
    font-size: 1.2em;
    margin: 20px 0;
}

/* Section Styling */
section {
    padding: 50px 0;
    text-align: center;
}

h2 {
    font-size: 2.5em;
    margin-bottom: 20px;
}

/* Programs */
.program-grid, .mentor-grid {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.program-card, .mentor-card {
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    width: 300px;
}

/* Events */
.event-card {
    background: white;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
}

/* Contact */
form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 600px;
    margin: auto;
}

input, textarea {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

/* Footer */
footer {
    background: #002147;
    color: white;
    padding: 20px 0;
    text-align: center;
}
/* Video Section */
.video-section {
    background: var(--soft-cream);
    padding: 60px 0;
    text-align: center;
}

.video-section h2 {
    color: var(--deep-maroon);
    font-size: 2.5em;
    margin-bottom: 10px;
}

.video-section p {
    color: var(--dark-brown);
    font-size: 1.1em;
    margin-bottom: 40px;
}

.video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    overflow: hidden;
    max-width: 100%;
    border-radius: 10px;
}

.video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
}

/* Client Section */
.clients {
    background: var(--soft-cream);
    padding: 60px 0;
    text-align: center;
}

.clients h2 {
    color: var(--deep-maroon);
    font-size: 2.5em;
    margin-bottom: 10px;
}

.clients p {
    color: var(--dark-brown);
    font-size: 1.1em;
    margin-bottom: 40px;
}

.client-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px;
    justify-content: center;
    align-items: center;
}

.client-card {
    background: var(--golden-brown);
    padding: 20px;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.3s ease;
}

.client-card img {
    max-width: 100%;
    height: auto;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
}

.client-card:hover {
    transform: translateY(-10px);
}

.client-card:hover img {
    filter: grayscale(0%);
}
