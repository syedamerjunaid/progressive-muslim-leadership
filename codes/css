/* General Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    line-height: 1.8;
    color: #333;
    background-color: #f4f4f4;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

h1, h2, h3 {
    margin-bottom: 1.5rem;
    font-weight: 600;
}

/* Header */
.header {
    background-color: #0f172a;
    color: #fff;
    padding: 1.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header .logo {
    max-width: 180px;
}

.header nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
}

.header nav ul li a {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

.header nav ul li a:hover {
    color: #27ae60;
}

/* Hero Section */
.hero {
    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.5)), url('hero-bg.jpg') no-repeat center center/cover;
    color: white;
    padding: 6rem 0;
    text-align: center;
}

.hero h1 {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.hero p {
    font-size: 1.5rem;
    margin-bottom: 2rem;
}

.hero .btn {
    background-color: #27ae60;
    color: white;
    padding: 1rem 2.5rem;
    font-size: 1.2rem;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.3s;
}

.hero .btn:hover {
    background-color: #1f8d4c;
}

/* About Section */
.about {
    background: white;
    padding: 4rem 0;
    text-align: center;
}

.about p {
    font-size: 1.2rem;
    max-width: 800px;
    margin: 0 auto;
}

/* Programs Section */
.programs {
    background: #f9f9f9;
    padding: 4rem 0;
}

.program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
}

.program-card {
    background: white;
    padding: 2.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    text-align: center;
    font-size: 1.2rem;
}

/* Mentors Section */
.mentors {
    background: white;
    padding: 4rem 0;
    text-align: center;
}

.mentor-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
}

.mentor-card {
    background: #f4f4f4;
    padding: 2.5rem;
    border-radius: 12px;
    width: 300px;
}

/* Testimonials Section */
.testimonials {
    background: #27ae60;
    color: white;
    padding: 4rem 0;
    text-align: center;
}

.testimonials .testimonial-card {
    background: white;
    color: #333;
    padding: 2rem;
    border-radius: 12px;
    max-width: 800px;
    margin: 0 auto;
}

/* Contact Section */
.contact {
    background: white;
    padding: 4rem 0;
}

.contact form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 600px;
    margin: 0 auto;
}

.contact input, .contact textarea {
    padding: 1.2rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 1rem;
}

.contact button {
    background-color: #27ae60;
    color: white;
    padding: 1.2rem;
    font-size: 1.2rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s;
}

.contact button:hover {
    background-color: #1f8d4c;
}

/* Footer */
.footer {
    background-color: #0f172a;
    color: white;
    text-align: center;
    padding: 2rem 0;
    font-size: 1rem;
}

/* Responsive Design */
@media (max-width: 768px) {
    .program-grid, .mentor-grid {
        grid-template-columns: 1fr;
    }
    .program-card, .mentor-card {
        width: 100%;
    }
    .header nav ul {
        flex-direction: column;
        align-items: center;
    }
    .header nav ul li {
        margin-bottom: 1rem;
    }
}
