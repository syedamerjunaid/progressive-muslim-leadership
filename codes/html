<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NextGenMuslim - Leadership Academy</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://kit.fontawesome.com/YOUR-FONT-AWESOME-KIT.js" crossorigin="anonymous"></script>
</head>
<body>

    <!-- Navbar Section -->
    <header>
        <div class="container">
            <div class="logo">
                <img src="your-logo.png" alt="NextGenMuslim Logo">
            </div>
            <nav>
                <ul>
                    <li><a href="#about">About</a></li>
                    <li><a href="#programs">Programs</a></li>
                    <li><a href="#mentors">Mentors</a></li>
                    <li><a href="#events">Events</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
            <a href="#" class="btn">Join Us</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>Empowering the Future Muslim Leaders</h1>
            <p>Integrating Islamic education with modern technology, AI, and leadership skills.</p>
            <a href="#" class="btn">Explore More</a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2>About NextGenMuslim</h2>
            <p>We provide an educational ecosystem where Muslim students from schools and Madrasas collaborate, learn, and develop leadership skills.</p>
            <img src="https://ibb.co/Z6PFbKJV" alt="Students learning">
        </div>
    </section>

    <!-- Programs Section -->
    <section id="programs" class="programs">
        <div class="container">
            <h2>Our Programs</h2>
            <div class="program-grid">
                <div class="program-card">
                    <h3>Leadership Development</h3>
                    <p>Equipping students with essential leadership and decision-making skills.</p>
                </div>
                <div class="program-card">
                    <h3>Technology Integration</h3>
                    <p>Teaching AI, IT, and modern tools to enhance their future careers.</p>
                </div>
                <div class="program-card">
                    <h3>Islamic Studies</h3>
                    <p>Balancing traditional Islamic education with contemporary knowledge.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Mentors Section -->
    <section id="mentors" class="mentors">
        <div class="container">
            <h2>Meet Our Mentors</h2>
            <div class="mentor-grid">
                <div class="mentor-card">
                    <h3>Amina Khan</h3>
                    <p>Leadership Coach & Mentor</p>
                </div>
                <div class="mentor-card">
                    <h3>Omar Ali</h3>
                    <p>AI & Technology Expert</p>
                </div>
                <div class="mentor-card">
                    <h3>Sara Ahmed</h3>
                    <p>Islamic Scholar & Educator</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Events Section -->
    <section id="events" class="events">
        <div class="container">
            <h2>Upcoming Events</h2>
            <div class="event-card">
                <h3>Digital Leadership Workshop</h3>
                <p>Join us on March 15, 2025, to explore leadership in the digital age.</p>
            </div>
            <div class="event-card">
                <h3>AI in Islamic Education Seminar</h3>
                <p>Learn how AI is transforming Islamic education. April 10, 2025.</p>
            </div>
        </div>
    </section>
